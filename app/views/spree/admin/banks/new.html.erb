<% content_for :page_title do %>
  <%= link_to Spree.t(:back_to_banks_list), admin_banks_path %> /
  <%= Spree.t(:new_bank) %>
<% end %>

<div class="card">
  <div class="card-body">
    <%= form_for [:admin, @bank] do |f| %>
      <%= render partial: 'form', locals: { f: f } %>

      <div class="form-actions" data-hook="buttons">
        <%= button Spree.t('admin.materials.btn.send'), 'save.svg' %>
      </div>
    <% end %>
  </div>
</div>
