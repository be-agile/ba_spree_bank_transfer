<div data-hook="admin_banks_form_fields">
  <% if @bank.try(:errors).present? %>
    <%= render 'spree/admin/shared/error_messages', target: @bank %>
  <% end %>

  <div>
    <div class="form-group">
      <%= f.label :name, raw(Spree.t(:name) + required_span_tag) %>
      <%= f.text_field :name, class: 'form-control' %>
    </div>

    <div class="form-group">
      <%= f.label :account_no, raw(Spree.t(:account_no) + required_span_tag) %>
      <%= f.text_field :account_no, class: 'form-control' %>
    </div>

    <div class="form-group">
      <%= f.label :additional_details, Spree.t(:additional_details) %>
      <%= f.text_area :additional_details, rows: 10, class: 'form-control' %>
    </div>

    <div class="form-group">
      <%= f.label :active do %>
        <%= f.check_box :active %>
        <%= Spree.t(:active) %>
      <% end %>
    </div>

  </div>
</div>
